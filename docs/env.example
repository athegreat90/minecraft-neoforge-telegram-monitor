# Template for the runtime configuration. Copy it to `.env` and replace the placeholders.
# The real .env must NEVER be committed, pushed or baked into an image.
# Protect it on the deployment machine: chmod 600 .env

TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

MINECRAFT_CHANNEL_ID=@YourMinecraftChannel
NEOFORGE_CHANNEL_ID=@YourNeoForgeChannel

MINECRAFT_SNAPSHOTS=false
NEOFORGE_BETAS=true
NEOFORGE_MIN_MAJOR=26

POLL_SECONDS=300

# --- Optional settings (uncomment to override the defaults) ---

# Read the bot token from a file (for example a Docker secret) instead of TELEGRAM_BOT_TOKEN.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token

# MINECRAFT_PRERELEASES=false
# CHANGELOG_GRACE_MINUTES=30
# AMBIGUOUS_POLICY=retry
# DISPLAY_TIMEZONE=UTC
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# DB_PATH=/data/releases.sqlite3
